{
  "name": "career-development-placement-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean:next": "node -e \"require('fs').rmSync('frontend/.next', { recursive: true, force: true })\"",
    "dev": "npm run clean:next && next dev frontend",
    "dev:clean": "npm run clean:next && next dev frontend",
    "dev:frontend": "npm run clean:next && next dev frontend",
    "dev:all": "npm --prefix ../../backend run start:all",
    "start:all": "npm --prefix ../../backend run start:all",
    "build": "npm run clean:next && next build frontend",
    "start": "next start frontend",
    "lint": "eslint frontend",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@tanstack/react-query": "^5.81.5",
    "axios": "^1.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "next": "^15.3.5",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0",
    "recharts": "^3.0.2",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
