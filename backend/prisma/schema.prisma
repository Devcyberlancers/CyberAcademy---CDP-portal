generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model admin_course_lessons {
  id                          Int                  @id @default(autoincrement())
  module_id                   Int
  title                       String               @db.VarChar(180)
  video_url                   String?              @db.VarChar(500)
  duration_minutes            Int
  required_completion_percent Int
  admin_course_modules        admin_course_modules @relation(fields: [module_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "admin_course_lessons_ibfk_1")

  @@index([module_id], map: "module_id")
}

model admin_course_modules {
  id                   Int                    @id @default(autoincrement())
  course_id            Int
  title                String                 @db.VarChar(180)
  position             Int
  admin_course_lessons admin_course_lessons[]
  courses              courses                @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "admin_course_modules_ibfk_1")

  @@index([course_id], map: "course_id")
}

model admin_password_resets {
  id          Int         @id @default(autoincrement())
  admin_id    Int
  token_hash  String      @unique(map: "ix_admin_password_resets_token_hash") @db.VarChar(128)
  expires_at  DateTime    @db.DateTime(0)
  used_at     DateTime?   @db.DateTime(0)
  created_at  DateTime    @default(dbgenerated("(now())")) @db.DateTime(0)
  admin_users admin_users @relation(fields: [admin_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "admin_password_resets_ibfk_1")

  @@index([admin_id], map: "ix_admin_password_resets_admin_id")
}

model admin_snapshots {
  id         Int      @id @default(autoincrement())
  key        String   @unique(map: "ix_admin_snapshots_key") @db.VarChar(180)
  payload    String   @db.MediumText
  updated_by String?  @db.VarChar(255)
  updated_at DateTime @default(dbgenerated("(now())")) @db.DateTime(0)

  @@index([id], map: "ix_admin_snapshots_id")
}

model admin_student_messages {
  id            Int       @id @default(autoincrement())
  student_email String    @db.VarChar(255)
  message       String    @db.Text
  sent_by       String    @db.VarChar(255)
  sent_at       DateTime  @db.DateTime(0)
  read_at       DateTime? @db.DateTime(0)

  @@index([sent_at], map: "ix_admin_student_messages_sent_at")
  @@index([student_email], map: "ix_admin_student_messages_student_email")
}

model admin_users {
  id                    Int                     @id @default(autoincrement())
  name                  String                  @db.VarChar(120)
  email                 String                  @unique(map: "ix_admin_users_email") @db.VarChar(255)
  password_hash         String                  @db.VarChar(255)
  role                  admin_users_role
  is_active             Boolean
  created_at            DateTime                @default(dbgenerated("(now())")) @db.DateTime(0)
  admin_password_resets admin_password_resets[]

  @@index([id], map: "ix_admin_users_id")
}

model announcements {
  id           Int      @id @default(autoincrement())
  title        String   @db.VarChar(220)
  category     String   @db.VarChar(80)
  body         String   @db.Text
  published_at DateTime @db.DateTime(0)
}

model applications {
  id         Int      @id @default(autoincrement())
  student_id Int
  job_id     Int
  status     String   @db.VarChar(60)
  applied_at DateTime @db.DateTime(0)
  students   students @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "applications_ibfk_1")
  jobs       jobs     @relation(fields: [job_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "applications_ibfk_2")

  @@index([job_id], map: "job_id")
  @@index([student_id], map: "student_id")
}

model assessment_collections {
  id          Int      @id @default(autoincrement())
  storage_key String   @unique(map: "ix_assessment_collections_storage_key") @db.VarChar(255)
  kind        String   @db.VarChar(40)
  course_key  String?  @db.VarChar(120)
  payload     String   @db.Text
  updated_at  DateTime @default(dbgenerated("(now())")) @db.DateTime(0)

  @@index([course_key], map: "ix_assessment_collections_course_key")
  @@index([id], map: "ix_assessment_collections_id")
}

model assessment_submissions {
  id            Int       @id @default(autoincrement())
  course_key    String    @db.VarChar(120)
  assessment_id String?   @db.VarChar(120)
  student_id    Int?
  payload       String    @db.Text
  submitted_at  DateTime  @default(dbgenerated("(now())")) @db.DateTime(0)
  students      students? @relation(fields: [student_id], references: [id], onUpdate: NoAction, map: "assessment_submissions_ibfk_1")

  @@index([assessment_id], map: "ix_assessment_submissions_assessment_id")
  @@index([course_key], map: "ix_assessment_submissions_course_key")
  @@index([id], map: "ix_assessment_submissions_id")
  @@index([student_id], map: "student_id")
}

model assignment_attempts {
  id                  Int                        @id @default(autoincrement())
  assignment_id       String                     @db.VarChar(80)
  student_email       String                     @db.VarChar(255)
  status              assignment_attempts_status
  started_at          DateTime                   @db.DateTime(0)
  ended_at            DateTime?                  @db.DateTime(0)
  termination_reason  String?                    @db.VarChar(120)
  auto_submitted      Boolean
  violations          Int
  browser             String                     @db.VarChar(160)
  operating_system    String                     @db.VarChar(160)
  screen_resolution   String                     @db.VarChar(80)
  user_agent          String                     @db.VarChar(600)
  ip_address          String                     @db.VarChar(80)
  question_order_json Json
  option_order_json   Json
  answers_json        Json
  score               Int
  student_id          Int?
  attempt_number      Int?                       @default(1)
  assignment_events   assignment_events[]

  @@index([assignment_id], map: "ix_assignment_attempts_assignment_id")
  @@index([student_email], map: "ix_assignment_attempts_student_email")
  @@index([assignment_id, status, started_at], map: "ix_attempt_assignment_status_started")
  @@index([assignment_id, student_email, started_at], map: "ix_attempt_assignment_student_started")
  @@index([student_email, status], map: "ix_attempt_student_status")
}

model assignment_events {
  id                  Int                 @id @default(autoincrement())
  attempt_id          Int
  event_type          String              @db.VarChar(80)
  reason              String              @db.VarChar(160)
  details_json        Json
  created_at          DateTime            @db.DateTime(0)
  assignment_attempts assignment_attempts @relation(fields: [attempt_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "assignment_events_ibfk_1")

  @@index([attempt_id], map: "ix_assignment_events_attempt_id")
  @@index([event_type], map: "ix_assignment_events_event_type")
  @@index([attempt_id, created_at], map: "ix_event_attempt_created")
}

model assignment_security_settings {
  id                        Int                                           @id @default(autoincrement())
  assignment_id             String                                        @unique(map: "ix_assignment_security_settings_assignment_id") @db.VarChar(80)
  assignment_title          String                                        @db.VarChar(220)
  duration_minutes          Int
  enabled                   Boolean
  require_fullscreen        Boolean
  end_on_fullscreen_exit    Boolean
  end_on_tab_switch         Boolean
  end_on_blur               Boolean
  disable_right_click       Boolean
  disable_copy              Boolean
  disable_paste             Boolean
  disable_cut               Boolean
  disable_drag              Boolean
  disable_text_selection    Boolean
  disable_printing          Boolean
  disable_save_page         Boolean
  disable_inspect_shortcuts Boolean
  randomize_question_order  Boolean
  randomize_option_order    Boolean
  auto_save_answers         Boolean
  auto_submit_on_timer_end  Boolean
  log_device_info           Boolean
  log_browser_info          Boolean
  log_ip_address            Boolean
  log_session_changes       Boolean
  violation_policy          assignment_security_settings_violation_policy
  questions_json            Json
  created_at                DateTime                                      @db.DateTime(0)
  updated_at                DateTime                                      @db.DateTime(0)
  published                 Boolean?                                      @default(true)
  active                    Boolean?                                      @default(true)
  available_from            DateTime?                                     @db.DateTime(0)
  available_until           DateTime?                                     @db.DateTime(0)
  resume_allowed            Boolean?                                      @default(true)
  max_attempts              Int?                                          @default(3)
}

model audit_logs {
  id          Int      @id @default(autoincrement())
  actor_email String   @db.VarChar(255)
  action      String   @db.VarChar(120)
  target_type String   @db.VarChar(80)
  target_id   String?  @db.VarChar(80)
  details     String?  @db.Text
  created_at  DateTime @default(dbgenerated("(now())")) @db.DateTime(0)

  @@index([action], map: "ix_audit_logs_action")
  @@index([actor_email], map: "ix_audit_logs_actor_email")
  @@index([id], map: "ix_audit_logs_id")
}

model companies {
  id            Int     @id @default(autoincrement())
  name          String  @unique(map: "name") @db.VarChar(180)
  industry      String  @db.VarChar(120)
  website       String? @db.VarChar(255)
  hiring_status String  @db.VarChar(80)
}

model courses {
  id                         Int                          @id @default(autoincrement())
  title                      String                       @unique(map: "ix_courses_title") @db.VarChar(255)
  heading                    String                       @db.VarChar(255)
  category                   String                       @db.VarChar(120)
  level                      String                       @db.VarChar(80)
  status                     String                       @db.VarChar(80)
  progress_percent           Int
  assessments                Int
  labs                       Int
  start_date                 DateTime?                    @db.DateTime(0)
  end_date                   DateTime?                    @db.DateTime(0)
  icon                       String                       @db.VarChar(80)
  color                      String                       @db.VarChar(80)
  metadata_json              Json
  created_at                 DateTime                     @db.DateTime(0)
  updated_at                 DateTime                     @db.DateTime(0)
  admin_course_modules       admin_course_modules[]
  student_course_assignments student_course_assignments[]

  @@index([status], map: "ix_courses_status")
}

model departments {
  id       Int        @id @default(autoincrement())
  name     String     @unique(map: "name") @db.VarChar(160)
  code     String     @unique(map: "code") @db.VarChar(20)
  students students[]
}

model email_otps {
  id              Int       @id @default(autoincrement())
  email           String    @db.VarChar(255)
  purpose         String    @db.VarChar(60)
  code_hash       String    @db.VarChar(128)
  expires_at      DateTime  @db.DateTime(0)
  resend_count    Int
  verify_attempts Int
  consumed_at     DateTime? @db.DateTime(0)
  last_sent_at    DateTime  @db.DateTime(0)
  created_at      DateTime  @db.DateTime(0)

  @@index([email], map: "ix_email_otps_email")
  @@index([expires_at], map: "ix_email_otps_expires_at")
  @@index([purpose], map: "ix_email_otps_purpose")
}

model email_send_logs {
  id            Int      @id @default(autoincrement())
  recipient     String   @db.VarChar(255)
  subject       String   @db.VarChar(255)
  template      String   @db.VarChar(80)
  success       Boolean
  error_message String?  @db.Text
  created_at    DateTime @db.DateTime(0)

  @@index([recipient], map: "ix_email_send_logs_recipient")
}

model jobs {
  id              Int            @id @default(autoincrement())
  title           String         @db.VarChar(255)
  company         String         @db.VarChar(255)
  location        String         @db.VarChar(180)
  experience      String         @db.VarChar(120)
  salary          String         @db.VarChar(120)
  employment_type String         @db.VarChar(120)
  skills          String         @db.Text
  description     String         @db.Text
  posted_date     String         @db.VarChar(120)
  apply_url       String         @db.VarChar(800)
  company_logo    String?        @db.VarChar(800)
  platform        String         @db.VarChar(80)
  match_score     Float          @db.Float
  is_entry_level  Boolean
  created_at      DateTime       @db.DateTime(0)
  updated_at      DateTime       @db.DateTime(0)
  applications    applications[]

  @@index([company], map: "ix_jobs_company")
  @@index([is_entry_level], map: "ix_jobs_is_entry_level")
  @@index([location], map: "ix_jobs_location")
  @@index([platform], map: "ix_jobs_platform")
  @@index([title], map: "ix_jobs_title")
}

model password_reset_tokens {
  id         Int       @id @default(autoincrement())
  email      String    @db.VarChar(255)
  token_hash String    @db.VarChar(128)
  expires_at DateTime  @db.DateTime(0)
  used_at    DateTime? @db.DateTime(0)
  created_at DateTime  @db.DateTime(0)

  @@index([email], map: "ix_password_reset_tokens_email")
  @@index([expires_at], map: "ix_password_reset_tokens_expires_at")
  @@index([token_hash], map: "ix_password_reset_tokens_token_hash")
}

model portal_access_settings {
  id                  Int      @id @default(autoincrement())
  scope_key           String   @unique(map: "ix_portal_access_settings_scope_key") @db.VarChar(255)
  courses_enabled     Boolean
  assessments_enabled Boolean
  jobs_enabled        Boolean
  updated_by          String   @db.VarChar(255)
  updated_at          DateTime @db.DateTime(0)
}

model resume_analyses {
  id               Int       @id @default(autoincrement())
  student_id       Int?
  resume_filename  String    @db.VarChar(255)
  resume_text      String    @db.LongText
  overall_score    Int
  ats_score        Int
  grammar_score    Int
  formatting_score Int
  projects_score   Int
  skills_score     Int
  experience_score Int
  education_score  Int
  ai_response_json String    @db.LongText
  created_at       DateTime  @db.DateTime(0)
  students         students? @relation(fields: [student_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "resume_analyses_ibfk_1")

  @@index([student_id], map: "ix_resume_analyses_student_id")
}

model student_course_assignments {
  id          Int      @id @default(autoincrement())
  student_id  Int
  course_id   Int
  assigned_by String   @db.VarChar(255)
  assigned_at DateTime @db.DateTime(0)
  students    students @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "student_course_assignments_ibfk_1")
  courses     courses  @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "student_course_assignments_ibfk_2")

  @@unique([student_id, course_id], map: "uq_student_course_assignment")
  @@index([course_id], map: "ix_student_course_assignments_course_id")
  @@index([student_id], map: "ix_student_course_assignments_student_id")
}

model student_daily_reminders {
  id            Int       @id @default(autoincrement())
  student_email String    @unique(map: "ix_student_daily_reminders_student_email") @db.VarChar(255)
  student_name  String    @db.VarChar(180)
  message       String    @db.Text
  send_time_ist DateTime  @db.Time(0)
  active        Boolean
  last_sent_on  DateTime? @db.Date
  created_by    String    @db.VarChar(255)
  updated_at    DateTime  @db.DateTime(0)
}

model student_job_search_preferences {
  id              Int      @id @default(autoincrement())
  student_email   String   @unique(map: "ix_student_job_search_preferences_student_email") @db.VarChar(255)
  search_time_ist String   @db.VarChar(5)
  active          Boolean
  last_run_on     String?  @db.VarChar(10)
  updated_at      DateTime @db.DateTime(0)
}

model student_profiles {
  id                  Int      @id @default(autoincrement())
  email               String   @unique(map: "ix_student_profiles_email") @db.VarChar(255)
  full_name           String   @db.VarChar(180)
  first_name          String   @db.VarChar(80)
  cyberlancers_id     String   @db.VarChar(80)
  registration_number String   @db.VarChar(80)
  phone               String   @db.VarChar(40)
  gender              String   @db.VarChar(40)
  date_of_birth       String   @db.VarChar(40)
  tag                 String   @db.VarChar(120)
  batch               String   @db.VarChar(40)
  course              String   @db.VarChar(180)
  college             String   @db.VarChar(180)
  department          String   @db.VarChar(180)
  status              String   @db.VarChar(80)
  resume_url          String   @db.VarChar(500)
  mentor_name         String   @db.VarChar(180)
  photo_data_url      String?  @db.LongText
  updated_at          DateTime @db.DateTime(0)
  resume_file_name    String?  @default("") @db.VarChar(255)
  resume_data_url     String?  @db.LongText
  personal_email      String?  @db.VarChar(255)
}

model students {
  id                         Int                          @id @default(autoincrement())
  user_id                    Int
  department_id              Int
  full_name                  String                       @db.VarChar(180)
  usn                        String                       @unique(map: "usn") @db.VarChar(40)
  cgpa                       Decimal                      @db.Decimal(3, 2)
  skills                     String                       @db.Text
  resume_url                 String?                      @db.VarChar(500)
  applications               applications[]
  assessment_submissions     assessment_submissions[]
  resume_analyses            resume_analyses[]
  student_course_assignments student_course_assignments[]
  users                      users                        @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "students_ibfk_1")
  departments                departments                  @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "students_ibfk_2")

  @@index([department_id], map: "department_id")
  @@index([user_id], map: "user_id")
}

model users {
  id              Int        @id @default(autoincrement())
  email           String     @unique(map: "ix_users_email") @db.VarChar(255)
  hashed_password String     @db.VarChar(255)
  role            users_role
  is_active       Boolean
  created_at      DateTime   @db.DateTime(0)
  students        students[]
}

enum assignment_attempts_status {
  in_progress
  completed
  terminated
  auto_submitted
}

enum users_role {
  student
  recruiter
  admin
}

enum admin_users_role {
  super_admin
  course_admin
  placement_admin
  student_admin
  viewer
}

enum assignment_security_settings_violation_policy {
  warning
  auto_submit
  end_exam
}
