# Created automatically by `npm run setup` for an isolated local MySQL container.
# It is intentionally for local development only. Never deploy these values.
NODE_ENV=development
PORT=8000
DATABASE_URL=mysql://cyber_portal:cyber_portal@127.0.0.1:3306/cyber_academy
JWT_SECRET=local-development-only-change-before-any-public-deployment-123456789
