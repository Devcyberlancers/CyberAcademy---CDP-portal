FROM node:22-alpine

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_STUDENT_API_BASE_URL
ARG NEXT_PUBLIC_STUDENT_PORTAL_URL
ARG NEXT_PUBLIC_STUDENT_PORTAL_LINK
ARG NEXT_PUBLIC_DEFAULT_SENDER_EMAIL
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL \
    NEXT_PUBLIC_STUDENT_API_BASE_URL=$NEXT_PUBLIC_STUDENT_API_BASE_URL \
    NEXT_PUBLIC_STUDENT_PORTAL_URL=$NEXT_PUBLIC_STUDENT_PORTAL_URL \
    NEXT_PUBLIC_STUDENT_PORTAL_LINK=$NEXT_PUBLIC_STUDENT_PORTAL_LINK \
    NEXT_PUBLIC_DEFAULT_SENDER_EMAIL=$NEXT_PUBLIC_DEFAULT_SENDER_EMAIL
RUN npm run build
RUN chown -R node:node /app
USER node
EXPOSE 3001
CMD ["npm", "run", "start", "--", "-H", "0.0.0.0", "-p", "3001"]
